DATABASE_URL=postgresql://fit_trace:fit_trace@localhost:5432/fit_trace?schema=public
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN_SECONDS=604800

# AI 识别：mock = 内置模拟识别（不分析图片，仅用于打通流程）
#          openai = 真实视觉识别（兼容 OpenAI 协议的服务），需要配置 AI_API_KEY
AI_PROVIDER=mock
AI_API_KEY=
# 示例：硅基流动
AI_MODEL=Qwen/Qwen3-VL-32B-Instruct
AI_BASE_URL=https://api.siliconflow.cn/v1
AI_TIMEOUT_MS=45000
# responses = OpenAI 官方；chat = 硅基流动 / 通义 / 智谱 / 豆包等兼容端点
AI_API_MODE=chat
# json_schema 能约束字段名，最不容易丢数据；服务不支持时退回 json_object 或 none
AI_RESPONSE_FORMAT=json_schema

STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./.uploads
STORAGE_PUBLIC_PREFIX=/uploads
STORAGE_PUBLIC_URL=http://localhost:3000
API_PORT=3000
VITE_API_BASE_URL=http://localhost:3000/api/v1
