generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  nickname     String?
  avatarUrl    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  bodyRecords  BodyRecord[]
  mealRecords  MealRecord[]

  @@map("users")
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model BodyRecord {
  id         String   @id @default(uuid())
  userId     String
  weight     Decimal  @db.Decimal(6, 2)
  bodyFat    Decimal? @db.Decimal(5, 2)
  waist      Decimal? @db.Decimal(6, 2)
  chest      Decimal? @db.Decimal(6, 2)
  hip        Decimal? @db.Decimal(6, 2)
  recordedAt DateTime
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt])
  @@map("body_records")
}

model MealRecord {
  id         String   @id @default(uuid())
  userId     String
  type       MealType
  recordedAt DateTime
  note       String?
  imageUrl   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  foods FoodItem[]

  @@index([userId, recordedAt])
  @@map("meal_records")
}

model FoodItem {
  id           String   @id @default(uuid())
  mealRecordId String
  name         String
  amount       String?
  calories     Int?
  aiGenerated  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  mealRecord MealRecord @relation(fields: [mealRecordId], references: [id], onDelete: Cascade)

  @@index([mealRecordId])
  @@map("food_items")
}
