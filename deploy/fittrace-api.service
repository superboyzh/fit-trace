[Unit]
Description=FitTrace API
After=network.target postgresql.service

[Service]
Type=simple
User=fittrace
Group=fittrace
WorkingDirectory=/opt/fittrace/current/apps/api
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=256
EnvironmentFile=/etc/fittrace/api.env
ExecStart=/opt/fittrace/runtime/bin/node dist/main.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
MemoryHigh=384M
MemoryMax=512M
MemorySwapMax=128M
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/fittrace
SyslogIdentifier=fittrace-api

[Install]
WantedBy=multi-user.target
